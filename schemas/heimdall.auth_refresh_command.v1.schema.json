{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heimdall.auth_refresh_command.v1",
  "type": "object",
  "required": ["schema", "refreshToken", "entitlementPolicy"],
  "properties": {
    "schema": { "const": "heimdall.auth_refresh_command.v1" },
    "refreshToken": { "type": "string", "minLength": 1 },
    "entitlementPolicy": {
      "type": "object",
      "required": ["kind", "guildId", "allowedRoleIds"],
      "properties": {
        "kind": { "const": "discord_role_access" },
        "guildId": { "type": "string", "minLength": 1 },
        "allowedRoleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
