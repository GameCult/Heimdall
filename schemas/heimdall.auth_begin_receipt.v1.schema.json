{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heimdall.auth_begin_receipt.v1",
  "type": "object",
  "required": ["schema", "status", "handle", "expiresAt", "navigation"],
  "properties": {
    "schema": { "const": "heimdall.auth_begin_receipt.v1" },
    "status": { "const": "pending" },
    "handle": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "navigation": {
      "type": "object",
      "required": ["url", "allowedOrigins"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "allowedOrigins": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
