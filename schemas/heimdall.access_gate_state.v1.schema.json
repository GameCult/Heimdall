{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heimdall.access_gate_state.v1",
  "type": "object",
  "required": ["schema", "state", "title", "detail", "canBegin", "canComplete"],
  "properties": {
    "schema": { "const": "heimdall.access_gate_state.v1" },
    "state": { "enum": ["anonymous", "pending", "denied", "authenticated", "expired", "unavailable"] },
    "title": { "type": "string", "minLength": 1 },
    "detail": { "type": "string" },
    "canBegin": { "type": "boolean" },
    "canComplete": { "type": "boolean" },
    "displayName": { "type": "string" }
  },
  "additionalProperties": false
}
